{
  "id": "login",
  "kind": "cdp",
  "version": 1,
  "source": {
    "as_id": "Пользователь может войти с валидными credentials",
    "lang": "typescript-playwright",
    "fingerprint": "8b855eaf72d372fef162667f4fba7cb68343d4a0626887c8a6478ee8a5a87b1c"
  },
  "steps": [
    {
      "op": "navigate",
      "url": "login"
    },
    {
      "op": "wait",
      "selector": "[data-testid=login-input]",
      "timeout_ms": 5000
    },
    {
      "op": "fill",
      "selector": "[data-testid=login-input]",
      "value": "user1"
    },
    {
      "op": "fill",
      "selector": "[data-testid=password-input]",
      "value": "password1"
    },
    {
      "op": "click",
      "selector": "[data-testid=submit-button]"
    },
    {
      "op": "wait",
      "selector": "[data-testid=welcome-message]",
      "timeout_ms": 5000
    },
    {
      "op": "text",
      "selector": "[data-testid=welcome-message]",
      "value": "Welcome, user1!"
    }
  ]
}
